-- ***3. DQL

-- Junta as tabelas para mostrar o relatório completo de cada venda
SELECT
  v.data_venda,
  v.quantidade,
  ve.nome AS vendedor,
  c.nome AS cliente,
  f.nome AS fruta
FROM vendas AS v
JOIN vendedores AS ve ON ve.id_vendedor = v.id_vendedor
JOIN clientes AS c ON c.id_cliente = v.id_cliente
JOIN frutas AS f ON f.id_fruta = v.id_fruta
ORDER BY v.data_venda, ve.nome;

