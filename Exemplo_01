(1, 1, '2026-09-01', '14:00:00'),
(2, 2, '2026-09-02', '13:30:00');

-- Atualizar dados (Idade da Maria e e-mails deles)
UPDATE Pessoa SET idade = 26 WHERE id = 2;
UPDATE Pessoa SET email = 'joao.silva@email.com' WHERE id = 1;
UPDATE Pessoa SET email = 'maria.souza@email.com' WHERE id = 2;


-- 3. DQL (Consulta de Dados)

-- Mostrar a estrutura e as tabelas
SHOW TABLES;
DESCRIBE Pessoa;
DESCRIBE Compromisso;

