# Modelagem_de_Banco_de_Dados_SGBD
## Tabela de 10 registros de Alunos e Cursos 

CREATE TABLE Alunos (
  id INT PRIMARY KEY,
  nome VARCHAR(100) NOT NULL,
  idade INT NOT NULL,
  email VARCHAR(100) NOT NULL
);



CREATE TABLE Cursos (
  id INT PRIMARY KEY,
  nome VARCHAR(100) NOT NULL,
  carga_horaria INT NOT NULL,
  categoria VARCHAR(100) NOT NULL
);



